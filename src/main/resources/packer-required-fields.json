{
  "version": 1,
  "blocks": {
    "source:virtualbox-iso": {
      "url": "https://developer.hashicorp.com/packer/integrations/hashicorp/virtualbox/latest/components/builder/iso",
      "fields": [
        {
          "name": "iso_url",
          "unlessAny": [
            "iso_urls"
          ]
        },
        {
          "name": "iso_checksum"
        },
        {
          "name": "ssh_username",
          "when": {
            "field": "communicator",
            "equals": "ssh",
            "default": "ssh"
          }
        },
        {
          "name": "winrm_username",
          "when": {
            "field": "communicator",
            "equals": "winrm"
          }
        }
      ]
    },
    "source:qemu": {
      "url": "https://developer.hashicorp.com/packer/integrations/hashicorp/qemu/latest/components/builder/qemu",
      "fields": [
        {
          "name": "iso_url",
          "unlessAny": [
            "iso_urls"
          ]
        },
        {
          "name": "iso_checksum"
        },
        {
          "name": "ssh_username",
          "when": {
            "field": "communicator",
            "equals": "ssh",
            "default": "ssh"
          }
        },
        {
          "name": "winrm_username",
          "when": {
            "field": "communicator",
            "equals": "winrm"
          }
        }
      ]
    },
    "source:amazon-ebs": {
      "url": "https://developer.hashicorp.com/packer/integrations/hashicorp/amazon/latest/components/builder/ebs",
