        {
          "name": "ssh_username",
          "when": {
            "field": "communicator",
            "equals": "ssh",
            "default": "ssh"
          }
        },
        {
          "name": "winrm_username",
          "when": {
            "field": "communicator",
            "equals": "winrm"
          }
        }
      ]
    },
    "source:docker": {
      "url": "https://developer.hashicorp.com/packer/integrations/hashicorp/docker/latest/components/builder/docker",
      "fields": [
        {
          "name": "image",
          "unlessAny": [
            "build"
          ]
        },
        {
          "name": "commit",
          "type": "bool",
          "unlessAny": [
            "discard",
            "export_path"
          ],
          "placeholder": "true"
        }
      ]
    },
    "source:docker/build": {
      "url": "https://developer.hashicorp.com/packer/integrations/hashicorp/docker/latest/components/builder/docker",
